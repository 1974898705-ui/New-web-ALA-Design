{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "ala-design-image-api",
  "account_id": "91551c29b88b49c9e4e75446efcfd9c3",
  "main": "src/index.js",
  "compatibility_date": "2026-11-05",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
